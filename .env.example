# ═══════════════════════════════════════════════════════════════
# Personal Cloud Storage - Environment Configuration Template
# Copy this to .env and fill in your values.
# NEVER commit .env to git!
# ═══════════════════════════════════════════════════════════════

# ─── MinIO ────────────────────────────────────────────────────
MINIO_ROOT_USER=fang-admin
MINIO_ROOT_PASSWORD=change-me-to-strong-random-password

# MinIO endpoint (host:port, no protocol)
MINIO_ENDPOINT=127.0.0.1:9000

# Whether MinIO is behind HTTPS (false for local, true if exposed via nginx)
MINIO_SECURE=false

# Default bucket name
MINIO_DEFAULT_BUCKET=personal-files

# ─── API Gateway ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=3000

# API Keys: comma-separated "name:secret" pairs
# Example: antigravity:abc123,cursor:def456,mobile:ghi789
# Each agent tool should use its own named key for audit logging.
API_KEYS=default:change-me-to-strong-random-api-key

# ─── Storage ──────────────────────────────────────────────────
CLOUD_WORKSPACE=/workspace/cloud

# Maximum single file upload size (MB)
MAX_UPLOAD_SIZE_MB=500

# Maximum context file size (MB)
MAX_CONTEXT_SIZE_MB=50

# How many backup versions to keep per context
CONTEXT_BACKUP_COUNT=5

# ─── Agent Bootstrap ─────────────────────────────────────────
# Public access URL shown in setup prompts and setup packages.
PUBLIC_BASE_URL=https://fang-cloud.mardio.top

# Optional future embedding provider. Empty means metadata-only search.
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
